# EditorConfig : standardise le style de fichier au niveau de l'éditeur
# (indentation, fin de ligne, encodage) - lu nativement par VS Code/Cursor.
# Rôle différent d'un linter : ne vérifie pas la logique du code,
# juste la mise en forme brute des fichiers, avant même Prettier/ESLint.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
