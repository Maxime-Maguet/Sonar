{
  "name": "sonar",
  "private": true,
  "version": "0.0.1",
  "description": "Cartographie de l'écosystème tech toulousain, pistes de candidature spontanée et CRM personnel.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run start:dev -w api",
    "studio": "npm run prisma:studio -w api",
    "lint:web": "npm run lint -w web",
    "lint:api": "npm run lint -w api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
