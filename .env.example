# PostgreSQL (docker compose → host port 5433)
# DATABASE_URL = adresse directe (obligatoire) : utilisée par la CLI Prisma
# (migrations, generate, seed) et par l'application si DATABASE_URL_POOLED est absente.
DATABASE_URL="postgresql://sonar:sonar@localhost:5433/sonar?schema=public"
# DATABASE_URL_POOLED = adresse via pooler (optionnelle) : lue par l'application
# au runtime ; si elle est absente ou vide, l'application utilise DATABASE_URL.
# DATABASE_URL_POOLED=""

# Auth (porte 3+, valeur locale uniquement)
JWT_SECRET="replace-with-a-long-random-string"

# France Travail / La Bonne Boîte v2 (OAuth client_credentials — API NestJS uniquement)
# URL token, scopes et routes : docs/LBB_API.md
FT_CLIENT_ID=""
FT_CLIENT_SECRET=""

# INSEE Sirene 3.11 (header X-INSEE-Api-Key-Integration)
INSEE_API_KEY=""

# Obligatoire : development | test | production (l'API refuse de démarrer sinon)
NODE_ENV="development"

# CORS — origine du front Next
WEB_ORIGIN="http://localhost:3000"
API_PORT="3001"

# Nombre de proxies devant l'API (optionnel). Absent ou vide = aucun proxy
# (travail en local). Entier >= 0 ; autre chose empêche l'API de démarrer.
# Sert à compter les limites par IP sur le visiteur et non sur le relais.
# La bonne valeur se mesure sur le déploiement de test.
# TRUST_PROXY_HOPS="1"

# Web — les deux variables ci-dessous sont lues par Next.js depuis apps/web/.env.local
# (PAS depuis ce .env racine, qui ne sert qu'à l'API) : les recopier là-bas.
# Web — base de l'API utilisée par le navigateur. Jamais de secret FT/INSEE ici.
# En local : URL absolue de l'API. En production : chemin relatif "/api"
# (même origine que le site, relayé vers l'API par une réécriture Next).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Web — adresse de l'API côté serveur uniquement (jamais exposée au navigateur).
# Si définie : Next relaie /api/* vers cette adresse et l'appel serveur de
# l'annuaire l'utilise. Vide en local (le navigateur appelle l'API en direct).
# En production : l'adresse réelle de l'API, avec NEXT_PUBLIC_API_URL="/api".
# API_DIRECT_URL="https://api.example.com"
